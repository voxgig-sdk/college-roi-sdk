# Entity: major

main: kit: entity: major: {

  alias: field: {}

  fields: {
    ai_exposure: {
      h: "Ai Exposure"
      n: "ai_exposure"
      r: false
      sh: "le-teen-derived AI applicability (exposure) — how much of the field’s occupations AI is already used for."
      t: [
        "`$ONE`"
        [
          "`$OBJECT`"
          "`$NULL`"
        ]
      ]
    }
    cip_program_name: {
      h: "Cip Program Name"
      n: "cip_program_name"
      r: false
