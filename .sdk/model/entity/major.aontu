        "`$ONE`"
        [
          "`$INTEGER`"
          "`$NULL`"
        ]
      ]
    }
    median_lifetime_roi_usd: {
      h: "Median Lifetime Roi Usd"
      n: "median_lifetime_roi_usd"
      r: false
      t: "`$NUMBER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
