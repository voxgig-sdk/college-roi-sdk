# Entity: index

main: kit: entity: index: {

  alias: field: {}

  name: "index"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/api/v1/index.json"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "index.json"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
