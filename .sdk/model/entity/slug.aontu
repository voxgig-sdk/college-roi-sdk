  name: "slug"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/v1/colleges/{slug}.json"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "slug"
                or: "slug"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/v1/colleges/{slug}.json"
          q: {
            exist: [
              "slug"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "colleges"
            }
            {
              lit: "{slug}.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /api/v1/majors/{slug}.json"
            source: "openapi3"
            version: 2
          }
          g: {
