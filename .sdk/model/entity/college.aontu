      h: "Npv 30yr Nonresident Usd"
      n: "npv_30yr_nonresident_usd"
      r: false
      sh: "Non-resident 30-year NPV — public schools with a real out-of-state premium only, and only when ALSO positive; null otherwise by design."
      t: [
        "`$ONE`"
        [
          "`$INTEGER`"
          "`$NULL`"
        ]
      ]
    }
    npv_30yr_resident_usd: {
      h: "Npv 30yr Resident Usd"
