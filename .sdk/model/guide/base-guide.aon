      op: load: method: *GET
    }
  }

  entity: out_of_state_penalty: {
    path: "/api/v1/rankings/out-of-state-penalty.json": {
      op: list: method: *GET
    }
  }

  entity: slug: {
    path: "/api/v1/colleges/{slug}.json": {
      op: load: method: *GET
    }
    path: "/api/v1/majors/{slug}.json": {
      op: load: method: *GET
    }
  }

