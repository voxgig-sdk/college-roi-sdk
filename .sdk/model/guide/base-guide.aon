      op: list: method: *GET
    }
  }

  entity: college: {
    path: "/api/v1/colleges.json": {
      op: list: method: *GET
    }
  }

  entity: index: {
    path: "/api/v1/index.json": {
      op: load: method: *GET
    }
  }

  entity: major: {
    path: "/api/v1/majors.json": {
      op: list: method: *GET
    }
  }

  entity: openapi: {
